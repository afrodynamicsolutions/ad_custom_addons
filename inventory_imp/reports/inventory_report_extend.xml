<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template inherit_id="stock.report_picking" id="inventory_imp_extend">
        <xpath expr="//table/thead/tr" position="after">
            <t t-set="counter" t-value="1"/>
        </xpath>

        <xpath expr="//table/thead/tr" position="inside">
            <th name="th_imp_tax">
                Customs Id
            </th>

        </xpath>
        <xpath expr="//table/thead/tr/th[@name='th_product']" position="before">
            <th name="seq_no">
                No
            </th>

        </xpath>
        <xpath expr="//table/tbody/tr/td[1]" position="before">
            <td>
                <span t-esc="counter"/>
            </td>
            <t t-set="counter" t-value="counter + 1"/>
        </xpath>
        <xpath expr="//table/thead/tr/th[@name='th_serial_number']" position="replace"/>


        <xpath expr="//td[@t-if='has_serial_number']" position="replace"/>

        <xpath expr="//table/tbody/tr" position="inside">
            <td t-esc="ml.move_id.customs_id"/>

        </xpath>
        <xpath expr="//div[hasclass('page')]" position="after">
            <div class="container" style="page-break-inside: avoid">
                <div class="container-fluid d-flex flex-row">
                    <div class="me-5">
                        <h5>Prepared By</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>
                    </div>
                    <div class="me-5">
                        <h5>Received By</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>
                    </div>

                    <div class="me-5">
                        <h5>Authorized By</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>
                    </div>
                </div>
               <t t-if="o.picking_type_id.code == 'internal'">
                    <br/>
                <div class="container mt-5">
                    <div>
                        <h5>Outgoing Custom</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>
                    </div>
                </div>
                </t>
            </div>
        </xpath>
    </template>
    <template inherit_id="stock.report_delivery_document" id="inventory_imp_extend_delivery">
        <xpath expr="//table[@name='stock_move_table']/thead/tr" position="inside">
            <th name="th_imp_tax">
                Customs Id
            </th>

        </xpath>

        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[1]" position="before">
            <th name="seq_no">
                NO
            </th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody" position="before">
            <t t-set="counter" t-value="1"/>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[1]" position="before">
            <td>
                <span t-esc="counter"/>
                <t t-set="counter" t-value="counter + 1"/>
            </td>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr" position="inside">
            <td t-esc="move.customs_id"/>

        </xpath>

        <xpath expr="//div[hasclass('page')]" position="after">
            <div class="container-fluid m-0" style="page-break-inside: avoid">

                <div class="container-fluid d-flex flex-row">
                    <div class="me-5">
                        <h5>Prepared By</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>
                    </div>
                    <div class="me-5">
                        <h5>Received By</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>

                    </div>

                    <div class="me-5">
                        <h5>Authorized By</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>
                    </div>
                </div>
                <t t-if="o.picking_type_id.code == 'internal'">
                    <br/>
                <div class="container mt-5">
                    <div>
                        <h5>Outgoing Custom</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>
                    </div>
                </div>
                </t>
            </div>
        </xpath>

    </template>
</odoo>